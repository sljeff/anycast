# Generated project — the source of truth is project.yml (xcodegen).
# Keep the shared SPM lockfile so dependency versions (e.g. GRDB 7.11.1)
# stay reproducible after `xcodegen generate`; exclude the rest. Git cannot
# re-include a file under an ignored directory, so each parent level is
# re-included down to the lockfile.
*.xcodeproj/*
!*.xcodeproj/project.xcworkspace
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Secrets and SDK configuration, materialized from Infisical by
# scripts/bootstrap.sh (local) or scripts/materialize_app_config.sh
# (release CI) — see native/README.md for the by-hand fallback.
Anycast/Resources/Secrets.plist
Anycast/Resources/GoogleService-Info.plist

# Build artifacts
build/
DerivedData/
xcuserdata/
*.xcscmblueprint
