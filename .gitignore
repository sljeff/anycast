# Retired Flutter/Android working trees (removed from git 2026-11-15).
# The directories themselves stay on disk until their leftover ignored
# content (generated config, keystores, Pods, build caches) is reviewed
# and deleted by hand — ignore everything still under them.
/android/
/ios/
/lib/
/integration_test/
/build/
/.dart_tool/
/coverage/
/.flutter-plugins
/.flutter-plugins-dependencies

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.buildlog/
.history/
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code related
.classpath
.project
.settings/
.vscode/*
!.vscode/settings.json

# M0 test fixtures.
# The Flutter app was removed from this repository (2026-11-15), so
# payloads only the Flutter code could produce are FROZEN and tracked in
# git — they can never be regenerated (last regenerable commit: a48c34d,
# branch `native`, Flutter app pinned to 1.2.1+38):
#   test/fixtures/db/**                       real app DB/cache encodings
#   test/fixtures/opml/app_export.opml        the app's real OPML export
# Everything else is still regenerated from its recorded sources and
# stays gitignored (test/fixtures/README.md).
/test/fixtures/audio/
/test/fixtures/images/
/test/fixtures/api/
/test/fixtures/channels_index.json
/test/fixtures/rss/**/*.xml
/test/fixtures/opml/*
!test/fixtures/opml/app_export.opml

# Native iOS scratch build outputs (xcodebuild -derivedDataPath build/…).
/native/build/

# swift-snapshot-testing mismatch artifacts (SnapshotBaseline writes them
# next to the committed baselines on a failed verify).
*.actual.png
